# Research and paper layer. Leave trading in paper mode.
TRADING_MODE=paper

# Filesystem path only. Never paste a key, seed, or mnemonic into this file.
SOLANA_KEYPAIR_PATH=/absolute/path/to/wallet.json

# Hard caps. Code clamps looser values back to these ceilings and this reserve floor.
MAX_BUY_SOL=0.005
MAX_TOTAL_EXPOSURE_SOL=0.03
MIN_SOL_RESERVE=0.02
PAPER_BUY_SOL=0.005

# Optional threshold overrides. They cannot disable fail-closed checks.
# MIN_LIQUIDITY_SOL=5
# MAX_TOP_HOLDER_PCT=0.15
# MAX_CANDIDATE_AGE_SEC=180
# MAX_PRICE_IMPACT_BPS=300
# MAX_SLIPPAGE_BPS=150
# PAPER_WALLET_SOL=0.1

# Live trading stays off. Do not set these in this example.
# The execution CLI refuses unless both are set outside the repo defaults.
# LIVE_TRADING_CONFIRM=
# LIVE_NETWORK_SEND=
