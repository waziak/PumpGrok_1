# Research and paper bot. Leave trading in paper mode.
TRADING_MODE=paper

# Live broadcast stays off. A send is possible only when BOTH are set:
#   TRADING_MODE=live
#   LIVE_NETWORK_SEND=true
# npm run bot never reads a keypair and never broadcasts.
# npm run live prints the gate and exits without signing or sending.
LIVE_NETWORK_SEND=false

# Public address only. Do not put a key, seed, or mnemonic in this file.
BOT_WALLET_PUBKEY=2LmzxcxCfijZANvbiDrf8DcVRgUqY6PFwfB7wPVbsXCp

# Filesystem path only. The paper bot does not read this file.
# SOLANA_KEYPAIR_PATH=/absolute/path/to/wallet.json

SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Hard caps. Code clamps looser values back to these ceilings and this reserve floor.
MAX_BUY_SOL=0.005
MAX_TOTAL_EXPOSURE_SOL=0.03
MIN_SOL_RESERVE=0.02
PAPER_BUY_SOL=0.005

# Optional threshold overrides. They cannot disable fail-closed checks.
# MIN_LIQUIDITY_SOL=5
# MAX_TOP_HOLDER_PCT=0.15
# MAX_CANDIDATE_AGE_SEC=180
# MAX_PRICE_IMPACT_BPS=300
# MAX_SLIPPAGE_BPS=150
# PAPER_WALLET_SOL=0.1

# Optional qualitative reviews. Leave empty to keep scanning without Grok.
# XAI_API_KEY=
# GROK_API_KEY=
